# Copy this to .env for local development
# In Vercel, set these as Environment Variables in the project settings

# Required: Your Anthropic API key
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Google Apps Script webhook URL for question logging
# Leave blank to disable logging (bot still works without it)
# Setup instructions: see DEPLOY.md
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
